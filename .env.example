DATABASE_URL=postgresql+psycopg://routine:routine@localhost:5432/routine_ai
OPENROUTER_API_KEY=
# Any model id from https://openrouter.ai/models
OPENROUTER_MODEL=openai/gpt-4o-mini
# Get one from @BotFather on Telegram. Leave empty to run without the bot.
TELEGRAM_BOT_TOKEN=
DEFAULT_TIMEZONE=Asia/Tehran
REMINDER_CHECK_SECONDS=30
